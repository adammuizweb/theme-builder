{
  "name": "theme-builder",
  "version": "1.6.0",
  "title": "Theme Builder",
  "description": "Site Owner PHP theme source workspace with guarded editing, durable revisions, explicit Core update decisions, and read-only navigation to owner workspaces.",
  "author": "Adam Muiz",
  "author_uri": "https://jyavani.com/member/adammuiz/",
  "plugin_uri": "https://jyavani.com/plugin/theme-builder/",
  "homepage": "https://jyavani.com/plugin/theme-builder/",
  "icon": "icon.png",
  "requires": {
    "jyavani": ">=2.3.87",
    "php": ">=8.1",
    "extensions": ["pdo", "json", "zip", "mbstring", "tokenizer"]
  },
  "admin": {
    "pages": [
      {
        "route": "admin/tools/theme-builder",
        "file": "admin/index.php",
        "title": "Theme Builder",
        "site_owner": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/theme-builder/editor",
        "file": "admin/editor.php",
        "title": "Theme Editor",
        "hidden": true,
        "site_owner": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/theme-builder/installed",
        "file": "admin/installed.php",
        "title": "Installed Themes",
        "hidden": true,
        "site_owner": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/theme-builder/api/save_file",
        "file": "admin/api/save_file.php",
        "hidden": true,
        "site_owner": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/theme-builder/api/create_theme",
        "file": "admin/api/create_theme.php",
        "hidden": true,
        "site_owner": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/theme-builder/api/delete_theme",
        "file": "admin/api/delete_theme.php",
        "hidden": true,
        "site_owner": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/theme-builder/api/build_zip",
        "file": "admin/api/build_zip.php",
        "hidden": true,
        "site_owner": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/theme-builder/api/preview",
        "file": "admin/api/preview.php",
        "hidden": true,
        "site_owner": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/theme-builder/api/save_manifest",
        "file": "admin/api/save_manifest.php",
        "hidden": true,
        "site_owner": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/theme-builder/api/install_theme",
        "file": "admin/api/install_theme.php",
        "hidden": true,
        "site_owner": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/theme-builder/api/download_zip",
        "file": "admin/api/download_zip.php",
        "hidden": true,
        "site_owner": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/theme-builder/api/fork_theme",
        "file": "admin/api/fork_theme.php",
        "hidden": true,
        "site_owner": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/theme-builder/api/save_fork_file",
        "file": "admin/api/save_fork_file.php",
        "hidden": true,
        "site_owner": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/theme-builder/api/save_installed_file",
        "file": "admin/api/save_installed_file.php",
        "hidden": true,
        "site_owner": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/theme-builder/api/list_theme_revisions",
        "file": "admin/api/list_theme_revisions.php",
        "hidden": true,
        "site_owner": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/theme-builder/api/restore_theme_revision",
        "file": "admin/api/restore_theme_revision.php",
        "hidden": true,
        "site_owner": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/theme-builder/api/export_theme_source",
        "file": "admin/api/export_theme_source.php",
        "hidden": true,
        "site_owner": true,
        "roles": ["admin"]
      }
    ],
    "nav": [
      {
        "label": "Theme Builder",
        "icon": "palette",
        "page": "admin/tools/theme-builder",
        "parent": "tools",
        "site_owner": true,
        "roles": ["admin"]
      }
    ]
  },
  "static": {
    "copy": [
      {
        "from": "assets/css/builder.css",
        "to": "static/plugins/theme-builder/theme-builder.css"
      }
    ]
  },
  "assets": {
    "css": ["/static/plugins/theme-builder/theme-builder.css?v=1.6.0"],
    "js": []
  }
}
